# Copy to .env (git-ignored) and adjust. Variables already set in the environment take precedence.
DATABASE_URL=postgres://delectatech:delectatech@localhost:5432/delectatech
CELERY_BROKER_URL=redis://:delectatech@localhost:6379/0
# Production only (config.settings.production): required, never commit real values.
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=example.com
# Google venues file loaded by every new pipeline run (required by the load_google_venues step)
GOOGLE_VENUES_FILE=/data/google_venues.json
# Food taxonomy used by every new run to classify menu items (required by the categorize_menu_items step)
FOOD_CATEGORIES_FILE=/data/food_categories.xlsx
# Local embedding model (python src/libs/categorization/download_model.py); empty: menu items classified by rules only
CATEGORIZATION_EMBEDDING_MODEL_PATH=data/downloads/embedding_model
# Optional
# PIPELINE_OUTPUT_DIR=output
# PIPELINE_DISPATCH_HOUR=6
# CATEGORIZATION_MAX_ITEMS_PER_RUN=0   # 0: every item of the run is classified; N: at most N per run
# LOG_LEVEL=INFO
# Shared cache (failed logins of the dashboard are counted here); several web processes need Redis
# CACHE_URL=redis://:delectatech@localhost:6379/1
# Dashboard: requests per user and failed logins before a lockout
# DASHBOARD_THROTTLE_RATE=300/min
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_SECONDS=900
# CRAWLER_BATCH_SIZE=10         # venues crawled at the same time
